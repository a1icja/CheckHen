# Database
# Docker uses: postgres://ds490:ds490-secure-password@db:5432/postgres (service name 'db')
# Local dev uses: postgresql://ds490:ds490-secure-password@127.0.0.1:5432/postgres
DATABASE_URL=postgresql://ds490:ds490-secure-password@127.0.0.1:5432/postgres?connection_limit=20&pool_timeout=10

# App domain settings
NEXT_PUBLIC_EMAIL_DOMAIN=bu.edu

# Admin usernames (without @domain) — comma-separated
# e.g. ADMIN_EMAILS=jsmith,adoe
ADMIN_EMAILS=

# Optional: comma-separated extra emails allowed to sign in (for testing outside BU domain)
ALLOWED_TEST_EMAILS=

# Socket server URL
# Local dev: http://localhost:6060
# LAN classroom: http://<your-laptop-ip>:6060
# Docker (internal): http://socket:6060
NEXT_PUBLIC_SOCKET_URL=http://localhost:6060

# Auth.js Configuration
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# IMPORTANT: Change this based on where you're running the app
# For local dev: http://localhost:3000
# For ngrok: https://your-tunnel.ngrok.io
# For LAN classroom: http://<your-laptop-ip>:3000
NEXTAUTH_URL=http://localhost:3000
