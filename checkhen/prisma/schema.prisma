// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Class {
  id           String        @id @default(uuid())
  checkIns     CheckIn[]
  handRaises   HandRaise[]
  chatMessages ChatMessage[]
  paceSignals  PaceSignal[]
  name         String
  duration     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
}

model CheckIn {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  class         Class     @relation(fields: [classId], references: [id])
  classId       String
  socketId      String?
  anonymousName String?   // Anonymous name like "Swift Panda"
  isPresent     Boolean   @default(true)
  checkOutTime  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([classId, isPresent])
  @@index([userId, classId])
}

model HandRaise {
  id             String    @id @default(uuid())
  user           User      @relation(fields: [userId], references: [id])
  userId         String
  class          Class     @relation(fields: [classId], references: [id])
  classId        String
  isAcknowledged Boolean   @default(false)
  isRated        Boolean   @default(false)
  hasValue       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime? @updatedAt

  @@index([classId, isAcknowledged])
  @@index([userId, classId])
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  isAdmin        Boolean       @default(false)
  profilePicture String?       // URL from Google OAuth
  foodAllergies  String?       // Free-text, e.g. "peanuts, dairy"
  checkIns       CheckIn[]
  handRaises     HandRaise[]
  chatMessages   ChatMessage[]
  paceSignals    PaceSignal[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime?     @updatedAt
}

model ChatMessage {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id])
  userId        String
  class         Class     @relation(fields: [classId], references: [id])
  classId       String
  message       String
  anonymousName String?   // Anonymous name shown to students
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([classId])
}

model PaceSignal {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  class      Class     @relation(fields: [classId], references: [id])
  classId    String
  signalType String    // "slow_down" or "ready_to_move_on"
  createdAt  DateTime  @default(now())

  @@index([classId, signalType])
}